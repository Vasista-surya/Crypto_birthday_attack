# Environment variables for Birthday Attack Lab
# Copy this file to .env and modify values as needed

# ============================================
# BACKEND (FastAPI) — Set in Railway/Render/Fly.io
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Production: CORS_ORIGINS=https://your-vercel-app.vercel.app
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# FRONTEND (Vite/React) — Set in Vercel Dashboard
# ============================================
# Local: VITE_API_BASE=http://localhost:8000/api
# Production: VITE_API_BASE=https://your-backend.railway.app/api
VITE_API_BASE=/api